<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>car_launch</name>
  <version>0.1.0</version>
  <description>Master launch: chassis + description + lidar + camera + slam + nav + vision</description>
  <maintainer email="root@roscar.local">root</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>car_base</depend>
  <depend>car_description</depend>
  <depend>ydlidar_ros2_driver</depend>
  <depend>camera</depend>
  <depend>car_slam</depend>
  <depend>car_nav</depend>
  <depend>car_vision</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>